msgstr "Angehalten"

#: extension.js:75
msgid "No connection to OneDrive"
msgstr "Keine Verbindung zu OneDrive"

#: extension.js:76
msgid "Sign-in required"
msgstr "Anmeldung erforderlich"

#: extension.js:77
msgid "Resync required"
msgstr "Neuabgleich erforderlich"

#: extension.js:78
msgid "Error"
msgstr "Fehler"

#: extension.js:79
msgid "Status unknown"
msgstr "Zustand unbekannt"

#: extension.js:224
