#: prefs.js:17
msgid "Menu"
msgstr "Menü"

#: prefs.js:24
msgid "Recent Entries"
msgstr "Letzte Einträge"

#: prefs.js:25
#, javascript-format
msgid "Number of entries shown (at most %s)"
msgstr "Anzahl der angezeigten Einträge (höchstens %s)"

#: prefs.js:32
msgid "File Operations Only"
msgstr "Nur Dateiaktionen"

#: prefs.js:33
msgid "Uploads, downloads, deletions and moves; otherwise all client messages"
msgstr ""
"Hoch- und Herunterladen, Löschen, Verschieben; sonst alle Meldungen des "
"Clients"

#: prefs.js:46
msgid "Accounts"
msgstr "Konten"

#: prefs.js:47
msgid ""
"Names shown in the menu. Leave empty to show the address used to sign in."
msgstr ""
"Namen im Menü. Leer lassen, um die bei der Anmeldung verwendete Adresse "
"anzuzeigen."

#: auth-window.js:108
msgid ""
"Microsoft returned a sign-in code that this version of the client cannot "
"read. The client reads such codes from version 2.5.10 on – please update it."
msgstr ""
"Microsoft hat einen Anmeldecode geliefert, den diese Version des Clients "
"nicht lesen kann. Ab Version 2.5.10 liest der Client solche Codes – bitte "
"aktualisiere ihn."

#: auth-window.js:117
#, javascript-format
msgid "Microsoft reports: %s – %s"
msgstr "Microsoft meldet: %s – %s"
