#, javascript-format
msgid "No terminal found. Command: %s"
msgstr "Kein Terminal gefunden. Befehl: %s"

#: prefs.js:17
msgid "Menu"
msgstr "Menü"

#: prefs.js:25
#, javascript-format
msgid "Number of entries shown (at most %s)"
msgstr "Anzahl der angezeigten Einträge (höchstens %s)"

#: prefs.js:32
msgid "File Operations Only"
msgstr "Nur Dateiaktionen"

#: prefs.js:33
msgid "Uploads, downloads, deletions and moves; otherwise all client messages"
msgstr ""
"Hoch- und Herunterladen, Löschen, Verschieben; sonst alle Meldungen des "
"Clients"

#: prefs.js:46
msgid "Accounts"
msgstr "Konten"

#: prefs.js:47
msgid ""
"Names shown in the menu. Leave empty to show the address used to sign in."
msgstr ""
"Namen im Menü. Leer lassen, um die bei der Anmeldung verwendete Adresse "
"anzuzeigen."

#: auth-window.js:102
#, javascript-format
msgid "Microsoft reports: %s – %s"
msgstr "Microsoft meldet: %s – %s"
