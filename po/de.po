#, javascript-format
msgid "OneDrive: %s"
msgstr "OneDrive: %s"

#: extension.js:1114
#, javascript-format
msgid "Last sync: %s"
msgstr "Letzte Synchronisation: %s"

#: extension.js:1122
msgid "Pause"
msgstr "Anhalten"

#: extension.js:1122
msgid "Start"
msgstr "Starten"

#: extension.js:1128
msgid "Cancel Sign-in"
msgstr "Anmeldung abbrechen"

#: extension.js:1129
msgid "Sign In Again"
msgstr "Neu anmelden"

#: extension.js:1129
msgid "Sign In"
msgstr "Anmelden"

#: extension.js:1275 prefs.js:24
msgid "Recent Messages"
msgstr "Letzte Meldungen"

#: extension.js:1278
msgid "Full Log in Terminal"
msgstr "Vollständiges Protokoll im Terminal"

#: extension.js:1310
