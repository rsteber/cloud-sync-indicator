msgstr "Synchronisiert"

#: extension.js:60
msgid "Syncing …"
msgstr "Synchronisiert gerade …"

#: extension.js:61
msgid "Resync running …"
msgstr "Neuabgleich läuft …"

#: extension.js:62
msgid "Starting …"
msgstr "Startet …"

#: extension.js:63
msgid "Stopping …"
msgstr "Wird angehalten …"

#: extension.js:64
msgid "Paused"
msgstr "Angehalten"

#: extension.js:65
msgid "No connection to OneDrive"
msgstr "Keine Verbindung zu OneDrive"

#: extension.js:66
msgid "Sign-in required"
msgstr "Anmeldung erforderlich"

#: extension.js:67
msgid "Resync required"
msgstr "Neuabgleich erforderlich"

#: extension.js:68
msgid "Error"
msgstr "Fehler"

#: extension.js:69
msgid "Status unknown"
msgstr "Zustand unbekannt"

